{
  "expo": {
    "name": "DrinkYourWater",
    "slug": "DrinkYourWater",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.DrinkYourWater2.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2B7FFF"
      },
      "package": "com.DrinkYourWater2.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "DrinkYourWater"
    },
    "extra": {
      "eas": {
        "projectId": "43273842-0de9-4a76-9b9e-481b2eac7ccf"
      }
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#2B7FFF"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#F3F7FC",
          "dark": {
            "backgroundColor": "#06101D"
          }
        }
      ],
      "expo-font"
    ]
  }
}
